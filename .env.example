# Variable NAMES only -- no values. Real values are Key Vault-injected at
# runtime in Test/UAT/Prod, and a local .env (git-ignored) in Dev.
# See docs/implementation-blueprint/09-configuration-management.md §1-§2.

# ---- Postgres (system of record) ----
DATABASE_URL=postgresql+psycopg://sms:sms@localhost:5432/sms_dev

# ---- Neo4j (synced projection) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---- Qdrant (vector search) ----
QDRANT_URL=http://localhost:6333

# ---- AI Extraction Service + Demonstration Engine ----
# Key Vault-injected at runtime, never in a .env file beyond local Dev,
# never client-side (architecture §1.4 finding 3).
ANTHROPIC_API_KEY=

# ---- Entra ID (AuthN/AuthZ) -- per-environment app registrations ----
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# ---- Azure Blob Storage (document/evidence storage) ----
AZURE_BLOB_CONNECTION_STRING=

# ---- Contract version pin for client codegen ----
OPENAPI_SPEC_VERSION=0.2.0-draft

# ---- Feature flags (docs/implementation-blueprint/09-configuration-management.md §4) ----
DEMONSTRATION_AUTO_GENERATE=false
EXTRACTION_AUTO_ACCEPT_ENABLED=false
ONTOLOGY_CURATOR_APPROVAL_REQUIRED=true
MOC_RISK_REASSESSMENT_ENFORCED=true

# ---- Per-environment override of extraction confidence thresholds ----
# Dev/Test only -- see docs/knowledge-graph/04-ai-extraction-specification.md §6.
EXTRACTION_CONFIDENCE_OVERRIDE_AUTO_ACCEPT=
EXTRACTION_CONFIDENCE_OVERRIDE_FLAG_FOR_REVIEW=

ENVIRONMENT=dev

# ---- apps/web (Vite exposes only VITE_-prefixed vars to the browser bundle --
# never put a secret behind this prefix) ----
VITE_API_BASE_URL=http://localhost:8000
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
