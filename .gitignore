# =====================================================================================
# TP Risk Management SMS -- Safety Knowledge Graph Platform monorepo
# React (Vite/TS) + FastAPI (Python) + PostgreSQL + Neo4j + Qdrant + Docker + Azure
#
# What is deliberately NOT ignored, because it must be version controlled:
#   database/postgres/migrations/**, database/neo4j/**  (schema history, not generated data)
#   ontology/**                                          (governed taxonomy content)
#   docs/knowledge-graph/10-openapi.yaml                  (the API contract)
#   infrastructure/**                                     (Infrastructure as Code)
#   docs/**                                               (design baseline + blueprint)
#   database/postgres/seeds/pilot-register/**             (real reference data, not disposable)
#   .env.example                                          (config template -- names only, no values)
# =====================================================================================

# ---- Node / npm workspaces (apps/web, packages/*) ----
node_modules/
node_modules/.tmp/
dist/
dist-ssr/
*.local
*.tsbuildinfo
.npm/

# ---- Python / FastAPI (apps/api) ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version.local
*.sqlite3

# ---- Build outputs & bundler caches ----
build/
.vite/
.turbo/

# ---- Test, lint, type-check, coverage ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
htmlcov/
.coverage
.coverage.*
*.cover
.nyc_output/

# ---- Databases: local dev state, not seed/reference data ----
# Postgres/Neo4j/Qdrant Docker volumes are named volumes (see docker-compose.dev.yml),
# not bind-mounted into the repo, so no local data-directory ignore is needed here.
# This section exists for any ad-hoc local dumps a developer creates:
*.dump
*.dump.gz
neo4j-data/
qdrant-storage/

# ---- Environment / secrets ----
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key
!infrastructure/**/*.key.example

# ---- Azure development tooling ----
.azure/
*.PublishSettings

# ---- Docker ----
.docker/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ---- Temporary files ----
*.tmp
*.temp
.cache/
tmp/

# ---- Generated documentation artefacts (rendered output, not source) ----
docs/api/_generated/
site/

# ---- IDE settings ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.iml
*.iws
.fleet/

# ---- OS artefacts ----
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
